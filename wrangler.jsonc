{
  // Teel Ridge Book Club — Cloudflare Workers configuration.
  // See README.md ("Cloudflare production setup") for where each placeholder comes from.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookclub-teelridge",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  // Better Auth relies on AsyncLocalStorage, which is provided by nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run the Worker next to the D1 database rather than next to the visitor:
  // each API call makes several sequential queries, so this saves a
  // cross-country round trip per query.
  "placement": { "mode": "smart" },

  // Static SPA assets (built by Vite). Every request runs the Worker first so
  // it can force HTTPS and add security headers; private data (/api/*) is
  // never served by the asset layer.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // D1 database. Replace database_id with the ID printed by
  //   npx wrangler d1 create teel-ridge-book-club
  // (also shown in Cloudflare dashboard → Storage & Databases → D1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teel-ridge-book-club",
      "database_id": "48f8b1b9-d3bc-4cf0-8fa4-6817e5d470f1",
      "migrations_dir": "migrations"
    }
  ],

  // Realtime chat fan-out. The class is exported from worker/index.ts.
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "ClubRealtime" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClubRealtime"] }],

  // Non-secret configuration. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY,
  // TURNSTILE_SECRET_KEY, GOOGLE_BOOKS_API_KEY) are set with
  //   npx wrangler secret put NAME
  // and must never be committed.
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "Teel Ridge Book Club",
    // Your public HTTPS origin, e.g. https://books.example.com (no trailing slash).
    "PUBLIC_APP_URL": "https://bookclub.teelridge.com",
    // "resend" in production. "console" logs emails instead of sending them (development only).
    "EMAIL_PROVIDER": "resend",
    // A sender on a domain you verified in Resend, e.g. "Teel Ridge Book Club <books@example.com>".
    "EMAIL_FROM": "Teel Ridge Book Club <books@mail.teelridge.com>",
    // Turnstile site keys are public by design; the matching secret is a Wrangler secret.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFEuP9s8UvjnccDG",
    // PBKDF2 iterations for new password hashes (10000–100000). Lower only if
    // sign-ins fail with error 1102 on the Workers Free plan. See README.
    "PASSWORD_HASH_ITERATIONS": "100000"
  },

  // Daily housekeeping (expired sessions, rate-limit counters, old notifications).
  // Cron Triggers are included in the Workers Free plan.
  "triggers": { "crons": ["17 4 * * *"] },

  // The club's address (a Workers Custom Domain; Cloudflare manages its DNS record and certificate).
  "routes": [{ "pattern": "bookclub.teelridge.com", "custom_domain": true }],
  // Members use only the custom domain (sign-in is bound to PUBLIC_APP_URL).
  "workers_dev": false
}
