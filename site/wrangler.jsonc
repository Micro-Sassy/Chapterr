{
  // Chapterr marketing site (chapterr.io) — an assets-only Worker.
  // worker.js only hands requests to the static assets in ./public (with the
  // security headers from public/_headers and 404.html for unknown paths). The app lives in the Worker
  // configured by ../wrangler.jsonc (app.chapterr.io).
  //
  //   Preview: npx wrangler dev -c site/wrangler.jsonc
  //   Deploy:  npx wrangler deploy -c site/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chapterr-site",
  "main": "./worker.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "chapterr.io", "custom_domain": true },
    { "pattern": "www.chapterr.io", "custom_domain": true }
  ],
  "workers_dev": false
}
